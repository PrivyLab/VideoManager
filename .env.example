# VideoManager Environment Configuration
# If .env is present, DOWNLOAD_DIR takes precedence over storage/settings.json

DOWNLOAD_DIR=./downloads

# Optional SOCKS5 Proxies
# TOR_PROXY=socks5://127.0.0.1:9050
# WARP_PROXY=socks5://127.0.0.1:1080

# Phase 0A local-only infrastructure (docker-compose.phase0.yml).
# These credentials are for loopback-only development services; never reuse them outside local development.
PHASE0_POSTGRES_USER=videomanager
PHASE0_POSTGRES_PASSWORD=videomanager-local-only
PHASE0_POSTGRES_DB=videomanager
PHASE0_POSTGRES_ADMIN_PASSWORD=videomanager-admin-local-only
PHASE0_POSTGRES_PORT=5433
PHASE0_FRONTEND_PORT=5173
PHASE0_LOCALSTACK_PORT=4566
PHASE0_LOCALSTACK_SERVICES=s3
PHASE0_AWS_REGION=us-east-1
# LocalStack currently requires a valid auth token. Set LOCALSTACK_AUTH_TOKEN
# only in your ignored local .env or shell environment when using the aws profile.

